{
  "name": "shoalfi",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": ["web/app", "web/landing", "server"],
  "scripts": {
    "dev": "bun run --cwd web/app dev",
    "dev:landing": "bun run --cwd web/landing dev",
    "dev:server": "bun run --cwd server dev",
    "server:start": "bun run --cwd server start",
    "build": "bun run --cwd web/app build && bun run --cwd web/landing build",
    "lint": "bun run --cwd web/app lint && bun run --cwd web/landing lint",
    "typecheck": "bun run --cwd web/app typecheck && bun run --cwd web/landing typecheck && bun run --cwd server typecheck",
    "test:server": "bun run --cwd server test",
    "test:e2e": "bun run --cwd server test:e2e",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts",
    "contracts:fmt": "forge fmt --root contracts"
  },
  "devDependencies": {
    "@foundry-rs/forge": "^1.7.1"
  }
}
