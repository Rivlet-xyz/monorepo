# --- Secrets -----------------------------------------------------------------
# Subgraph Studio API key: https://thegraph.com/studio/apikeys/
GRAPH_API_KEY=
# Optional. Without it the API still runs; POST /ask returns the fallback answer.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
SUBGRAPH_MCP_URL=https://subgraphs.mcp.thegraph.com/sse

# --- Storage -----------------------------------------------------------------
# Any Postgres 14+. Append ?sslmode=require for hosted providers.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shoalfi
PORT=4000

# --- Subgraph IDs (Ethereum mainnet, The Graph Network) -----------------------
# Run `bun run --cwd server probe` to verify health before relying on these.
UNISWAP_V3_SUBGRAPH_ID=5zvR82QoaXYFyDEKLZ9t6v9adgnptxYpKpSbxtgVENFV
# messari | aave. The probe prints the recommended value.
LENDING_SOURCE=messari
MESSARI_AAVE_V3_SUBGRAPH_ID=JCNWRypm7FYwV8fx5HhzZPSFaMxgkPuw4TnR3Gpi81zk
MESSARI_COMPOUND_V3_SUBGRAPH_ID=AwoxEZbiWLvv6e3QdvdMZw4WDURdGbvPfHmZRc8Dpfz9
# Optional third lending source (Messari schema). Leave blank if the probe reports it stale.
MORPHO_BLUE_SUBGRAPH_ID=
AAVE_V3_OFFICIAL_SUBGRAPH_ID=Cd2gEDVeqnjBn1hSeqFMitw8Q1iiyV9FYUZkLNRcL87g

# --- Engine parameters -------------------------------------------------------
# Price move used for sellable depth (1000 = 10%).
SLIPPAGE_BPS=1000
# Share of sellable depth a protocol should lend against (0.30 = 30%).
CAP_FRACTION=0.30
# Price rise used for pump cost (10000 = 2x).
PUMP_TARGET_BPS=10000
# Depth below this is labelled "shallow".
SHALLOW_DEPTH_USD=5000000
MAX_POOLS_PER_TOKEN=5
MAX_TICK_PAGES_PER_POOL=5
MIN_MARKET_DEPOSIT_USD=10000
# Free-plan Graph keys: use */30 * * * * and MAX_TICK_PAGES_PER_POOL=3.
REFRESH_CRON=*/5 * * * *
